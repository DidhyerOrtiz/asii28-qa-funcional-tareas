classDiagram
    direction TB

    class CasoRegresionEjecutable {
        <<interface>>
        +obtenerId() String
        +obtenerRequisitoId() String
        +ejecutar(ContextoEjecucion, ObservacionManual) ResultadoEjecucion
    }

    class CasoManual {
        -String id
        -String requisitoId
        -List pasos
        -String resultadoEsperado
        +ejecutar(ContextoEjecucion, ObservacionManual) ResultadoEjecucion
    }

    class CasoReprueba {
        -String id
        -String requisitoId
        -String defectoOrigen
        -CasoRegresionEjecutable casoOriginal
        +ejecutar(ContextoEjecucion, ObservacionManual) ResultadoEjecucion
    }

    class CasoNegativoManual {
        -String id
        -String requisitoId
        +ejecutar(ContextoEjecucion, ObservacionManual) ResultadoEjecucion
    }

    class CasoBorrador {
        +String requisitoId
        +List pasos
        +String resultadoEsperado
        +estaCompleto() Boolean
    }

    class ValidadorCaso {
        +validar(CasoBorrador) Boolean
        +convertir(String, CasoBorrador) CasoManual
    }

    class ContextoEjecucion {
        +String version
        +String ambiente
        +String tenant
        +String rol
        +String ejecutor
        +String fecha
    }

    class ObservacionManual {
        +EstadoEjecucion estado
        +String resultadoObservado
        +List evidencias
        +String causaBloqueo
    }

    class ResultadoEjecucion {
        +String casoId
        +String requisitoId
        +EstadoEjecucion estado
        +String version
        +String ambiente
        +String tenant
        +String rol
        +String ejecutor
        +String fecha
        +String resultadoObservado
        +List evidencias
        +String causaBloqueo
    }

    class GestorCampana {
        +ejecutarCaso(CasoRegresionEjecutable, ContextoEjecucion, ObservacionManual) ResultadoEjecucion
    }

    CasoRegresionEjecutable <|.. CasoManual
    CasoRegresionEjecutable <|.. CasoReprueba
    CasoRegresionEjecutable <|.. CasoNegativoManual
    GestorCampana --> CasoRegresionEjecutable : ejecuta
    GestorCampana --> ContextoEjecucion : utiliza
    GestorCampana --> ObservacionManual : registra
    CasoManual --> ResultadoEjecucion : devuelve
    CasoReprueba --> ResultadoEjecucion : devuelve
    CasoNegativoManual --> ResultadoEjecucion : devuelve
    ValidadorCaso --> CasoBorrador : valida
    ValidadorCaso --> CasoManual : crea caso válido
    note for CasoRegresionEjecutable "Toda implementación acepta el mismo contexto y observación, y devuelve ResultadoEjecucion"
    note for CasoBorrador "No participa en campañas hasta ser validado"
